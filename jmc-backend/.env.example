NODE_ENV=development
PORT=5000

MONGO_URI=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (no trailing slash)
# e.g. FRONTEND_URL=http://localhost:5173,https://YOUR-FRONTEND.vercel.app
FRONTEND_URL=http://localhost:5173

# Public WhatsApp number used for direct product enquiries.
# Digits only, international format (91 = India country code).
JMC_WHATSAPP_NUMBER=

# Optional public contact details returned by GET /api/settings/contact
JMC_PHONE=
JMC_EMAIL=
JMC_ADDRESS=
JMC_INSTAGRAM=
JMC_FACEBOOK=
JMC_YOUTUBE=

# Customer cart/checkout/payments expose product prices. Keep false for the enquiry-only catalogue.
ONLINE_ORDERING_ENABLED=false

# INTERNATIONAL customers can see prices, use the cart and check out (COD / Razorpay).
# Indian customers stay enquiry-only. Set to false to switch international purchasing off.
INTERNATIONAL_ORDERING_ENABLED=true

# Currency. Product.price (set in the admin panel) is stored in BASE_CURRENCY.
BASE_CURRENCY=INR
SUPPORTED_CURRENCIES=INR,USD,EUR,GBP,AED,CAD,AUD,SGD
# Exchange rates are NEVER invented by the backend. Provide the ones you want to offer, as
# "1 BASE_CURRENCY = X of that currency". A currency without a rate is not offered at checkout.
# e.g. CURRENCY_RATES={"USD":0.0120,"GBP":0.0095}
CURRENCY_RATES=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Currencies your Razorpay account is enabled to charge (non-INR needs Razorpay international payments).
RAZORPAY_CURRENCIES=INR

# Used ONLY by `npm run seed` to create the first admin user.
# Required in production. Use a strong password and change it after first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
