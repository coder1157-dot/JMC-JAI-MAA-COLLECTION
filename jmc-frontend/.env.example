# Backend API base URL (must include /api, no trailing slash)
# Local:
VITE_API_URL=http://localhost:5000/api
# Production (Vercel): https://YOUR-RENDER-BACKEND.onrender.com/api

# Optional: destinations where Cash on Delivery is offered at checkout (comma-separated country names).
# Default "*" = every destination. The backend itself accepts COD for any shippable country.
# VITE_COD_COUNTRIES=India,United Arab Emirates
